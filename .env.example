# Never commit the real .env file. Create a bot with @BotFather.
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_TEST_MODE=0
# Numeric Telegram IDs, comma separated. Used for payment delivery alerts, not admin bypass.
OWNER_IDS=
DATABASE=data/tuxigap.sqlite3

# Optional OpenAI-compatible chat/completions service. Set an actual model supported by your provider.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_DAILY_LIMIT=100
AI_USER_DAILY_LIMIT=10

# Required before enabling paid access. Publish your own terms/refund policy.
SUPPORT_USERNAME=
TERMS_URL=
RETENTION_DAYS=14

# Optional real tg-spam backend. Use a different endpoint for each group.
# SPAM_ENGINES={"-1001234567890":"http://spam-engine:8080"}
SPAM_ENGINES={}
SPAM_ENGINE_PASSWORD=
CAS_TOKEN=

# Optional owner dashboard (separate process). Generate a random key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_TOKEN=
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Optional Telegram test environment: use a test bot token, never a production token.
# TELEGRAM_API_BASE=https://api.telegram.org
# Optional outbound proxy, forwarded by compose when set:
# ALL_PROXY=socks5://host:1080
